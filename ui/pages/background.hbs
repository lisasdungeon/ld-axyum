<div class="axyum-page axyum-catalog-page">
  <header class="page-intro">
    <p class="page-kicker">Origin</p>
    <h2 class="axyum-page-title">{{localize "LD_AXYUM.Pages.Background"}}</h2>
    <p class="axyum-page-description">
      Choose a background for skills, tools, and story hooks.
    </p>
  </header>

  <div class="axyum-catalog-toolbar">
    {{#if backgroundCompendiumFilters}}
    <div class="axyum-catalog-filters" role="group" aria-label="Filter by source">
      <span class="axyum-toolbar-label"><i class="fas fa-filter" aria-hidden="true"></i> Source</span>
      <div class="axyum-chip-row">
        {{#each backgroundCompendiumFilters}}
          <button type="button"
                  class="axyum-chip {{#if (eq this.id ../selectedBackgroundCompendiumFilter)}}is-active{{/if}}"
                  data-action="filterCompendium"
                  data-filter="{{this.id}}">
            <span>{{this.name}}</span>
            <span class="axyum-chip-count">{{this.count}}</span>
          </button>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>

  <div class="axyum-info-card-grid" role="listbox" aria-label="Backgrounds">
    {{#each backgrounds}}
      <button type="button"
              class="axyum-info-card {{#if (eq this.id ../characterData.background.id)}}is-selected{{/if}}"
              data-action="selectBackground"
              data-background-id="{{this.id}}"
              data-background-name="{{this.name}}"
              data-pack-name="{{this.packName}}"
              role="option"
              aria-selected="{{#if (eq this.id ../characterData.background.id)}}true{{else}}false{{/if}}">
        <header class="axyum-info-card-head">
          <span class="axyum-info-card-glyph" aria-hidden="true"><i class="fas fa-scroll"></i></span>
          <span class="axyum-info-card-titles">
            <span class="axyum-info-card-title">{{this.name}}</span>
            {{#if this.source}}
              <span class="axyum-catalog-source {{#if this.isHomebrew}}is-homebrew{{else}}is-official{{/if}}">{{this.source}}</span>
            {{/if}}
          </span>
        </header>
        <div class="axyum-info-card-chips">
          <span class="axyum-meta-chip axyum-meta-chip--accent">Skills</span>
        </div>
        <dl class="axyum-info-card-facts">
          <div><dt>Skills</dt><dd>{{this.skillsLabel}}</dd></div>
        </dl>
        {{#if this.description}}
          <p class="axyum-info-card-blurb">{{this.description}}</p>
        {{else}}
          <p class="axyum-info-card-blurb muted">{{this.skillsLabel}}</p>
        {{/if}}
      </button>
    {{else}}
      <div class="empty-state">
        {{#if isLoading}}
          <p>{{localize "LD_AXYUM.Messages.LoadingCompendia"}}</p>
        {{else}}
          <p>{{localize "LD_AXYUM.Messages.NoCompendiumContent"}}</p>
          <p class="muted">Enable background Item packs in the GM Hub compendium settings.</p>
        {{/if}}
      </div>
    {{/each}}
  </div>

  {{#if characterData.background.id}}
    <div class="axyum-selection-bar">
      <div class="axyum-selection-bar-copy">
        <span class="page-kicker">Selected</span>
        <strong class="axyum-selection-bar-name">{{characterData.background.name}}</strong>
      </div>
    </div>
  {{/if}}

  <input type="hidden" name="background.id" value="{{characterData.background.id}}">
  <input type="hidden" name="background.name" value="{{characterData.background.name}}">
</div>
