<div class="axyum-page axyum-catalog-page skills-page">
  <header class="page-intro">
    <p class="page-kicker">Skills</p>
    <h2 class="axyum-page-title">Choose your trained skills</h2>
    <p class="axyum-page-description">
      Pick from your class skill list. Background grants add to your total budget.
    </p>
  </header>

  <div class="axyum-catalog-toolbar">
    <div class="tally-chip">
      <span class="tally-label">Selected</span>
      <span class="tally-value">{{selectedSkillCount}} / {{skillChoices.total}}</span>
    </div>
    {{#if skillChoices.class.count}}
      <span class="axyum-meta-chip axyum-meta-chip--accent">{{skillChoices.class.name}}: {{skillChoices.class.count}}</span>
    {{/if}}
    {{#if skillChoices.background.count}}
      <span class="axyum-meta-chip">{{skillChoices.background.name}}: +{{skillChoices.background.count}}</span>
    {{/if}}
  </div>

  {{#if skillChoices.class.pool.length}}
    <p class="section-hint">
      Class pool:
      {{#each skillChoices.class.pool}}
        <span class="pool-skill">{{this}}</span>
      {{/each}}
    </p>
  {{/if}}

  <div class="axyum-info-card-grid skills-card-grid" role="listbox" aria-label="Skills">
    {{#each skillsList}}
      <button type="button"
              class="axyum-info-card axyum-info-card--skill {{#if this.selected}}is-selected{{/if}} {{#if this.locked}}is-locked{{/if}} {{#unless this.selectable}}is-disabled{{/unless}}"
              data-action="toggleSkill"
              data-skill-key="{{this.key}}"
              role="option"
              aria-selected="{{#if this.selected}}true{{else}}false{{/if}}"
              {{#if this.locked}}disabled{{/if}}
              {{#unless this.selectable}}{{#unless this.selected}}disabled{{/unless}}{{/unless}}>
        <header class="axyum-info-card-head">
          <span class="axyum-info-card-glyph" aria-hidden="true"><i class="fas fa-graduation-cap"></i></span>
          <span class="axyum-info-card-titles">
            <span class="axyum-info-card-title">{{this.label}}</span>
          </span>
        </header>
        <div class="axyum-info-card-chips">
          <span class="axyum-meta-chip">{{this.ability}}</span>
          <span class="axyum-meta-chip">{{this.modifier}}</span>
          {{#if this.inPool}}<span class="axyum-meta-chip axyum-meta-chip--rec">Class list</span>{{/if}}
          {{#if this.locked}}<span class="axyum-meta-chip">Granted</span>{{/if}}
        </div>
        {{#if this.explanation}}
          <p class="axyum-info-card-blurb">{{this.explanation}}</p>
        {{/if}}
      </button>
    {{/each}}
  </div>

  <div class="axyum-selection-bar">
    <div class="axyum-selection-bar-copy">
      <span class="page-kicker">Proficiency bonus</span>
      <strong class="axyum-selection-bar-name">+{{derivedStats.proficiencyBonus}}</strong>
      <span class="muted">added to selected skill checks</span>
    </div>
  </div>
</div>
