<div class="axyum-page axyum-catalog-page feats-page">
  <header class="page-intro">
    <p class="page-kicker">Feats &amp; ASIs</p>
    <h2 class="axyum-page-title">Improve your character</h2>
    <p class="axyum-page-description">
      At ASI levels (4, 8, 12, 16, 19) you may take a feat or an Ability Score Improvement instead.
    </p>
  </header>

  <div class="axyum-catalog-toolbar">
    <div class="tally-chip">
      <span class="tally-label">Used</span>
      <span class="tally-value">{{selectedFeatCount}} / {{asiCount}}</span>
    </div>
    <span class="muted">Level {{or characterData.totalLevel 1}}</span>
    <label class="axyum-check-row axyum-check-row--compact">
      <input type="checkbox" name="showHomebrew" data-action="toggleHomebrew" {{#if showHomebrew}}checked{{/if}} />
      <span class="axyum-check"></span>
      <span class="axyum-check-text">
        <strong>Custom content</strong>
        <small>Include homebrew feats</small>
      </span>
    </label>
  </div>

  {{#if (gt asiCount 0)}}
    <button type="button"
            class="axyum-package-card {{#if characterData.chooseASI}}is-selected{{/if}}"
            data-action="toggleASI">
      <header class="axyum-package-card-head">
        <span class="axyum-package-label"><i class="fas fa-arrow-up"></i> Ability Score Improvement</span>
        {{#if characterData.chooseASI}}
          <span class="axyum-meta-chip axyum-meta-chip--rec">Selected</span>
        {{/if}}
      </header>
      <p class="muted">Increase two ability scores by +1 each (or one by +2) instead of taking a feat.</p>
    </button>
  {{else}}
    <div class="empty-state">
      <p>No ASI / feat slots at this level yet. Browse feats below for later levels.</p>
    </div>
  {{/if}}

  <div class="axyum-info-card-grid feats-card-grid" role="listbox" aria-label="Feats">
    {{#each featsList}}
      {{#if (or ../showHomebrew (not this.isHomebrew))}}
        <button type="button"
                class="axyum-info-card axyum-info-card--feat {{#if (includes ../characterData.feats this.name)}}is-selected{{/if}}"
                data-action="toggleFeat"
                data-feat-name="{{this.name}}"
                role="option"
                aria-selected="{{#if (includes ../characterData.feats this.name)}}true{{else}}false{{/if}}">
          <header class="axyum-info-card-head">
            <span class="axyum-info-card-glyph" aria-hidden="true"><i class="fas fa-medal"></i></span>
            <span class="axyum-info-card-titles">
              <span class="axyum-info-card-title">{{this.name}}</span>
              <span class="axyum-info-card-subtitle {{#if this.isHomebrew}}is-homebrew{{else}}is-official{{/if}}">
                {{#if this.isHomebrew}}<i class="fas fa-scroll"></i>{{else}}<i class="fas fa-book"></i>{{/if}}
                {{#if this.source}}{{this.source}}{{else}}Feat{{/if}}
              </span>
            </span>
          </header>
          <div class="axyum-info-card-chips">
            {{#if this.requiresLevel}}<span class="axyum-meta-chip">Lv {{this.requiresLevel}}+</span>{{/if}}
            {{#if this.prerequisites.length}}<span class="axyum-meta-chip">Prereq: {{#each this.prerequisites}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
          </div>
          {{#if this.blurb}}
            <p class="axyum-info-card-blurb">{{this.blurb}}</p>
          {{/if}}
        </button>
      {{/if}}
    {{/each}}
  </div>
  {{#unless featsList.length}}
    <div class="empty-state">
      <p>{{localize "LD_AXYUM.Messages.NoFeatsAvailable"}}</p>
    </div>
  {{/unless}}
</div>
