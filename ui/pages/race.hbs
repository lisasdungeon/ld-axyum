<div class="axyum-page axyum-catalog-page">
  <header class="page-intro">
    <p class="page-kicker">Ancestry</p>
    <h2 class="axyum-page-title">{{localize "LD_AXYUM.Pages.Race"}}</h2>
    <p class="axyum-page-description">
      Choose your race or species — size, speed, senses, and traits.
    </p>
  </header>

  <div class="axyum-catalog-toolbar">
    {{#if raceCompendiumFilters}}
    <div class="axyum-catalog-filters" role="group" aria-label="Filter by source">
      <span class="axyum-toolbar-label"><i class="fas fa-filter" aria-hidden="true"></i> Source</span>
      <div class="axyum-chip-row">
        {{#each raceCompendiumFilters}}
          <button type="button"
                  class="axyum-chip {{#if (eq this.id ../selectedRaceCompendiumFilter)}}is-active{{/if}}"
                  data-action="filterCompendium"
                  data-filter="{{this.id}}">
            <span>{{this.name}}</span>
            <span class="axyum-chip-count">{{this.count}}</span>
          </button>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <label class="axyum-check-row axyum-check-row--compact">
      <input type="checkbox" name="showHomebrew" data-action="toggleHomebrew" {{#if showHomebrew}}checked{{/if}} />
      <span class="axyum-check"></span>
      <span class="axyum-check-text">
        <strong>Custom content</strong>
        <small>Include homebrew races</small>
      </span>
    </label>
  </div>

  <div class="axyum-info-card-grid" role="listbox" aria-label="Races">
    {{#each races}}
      <button type="button"
              class="axyum-info-card {{#if (eq this.id ../characterData.race.id)}}is-selected{{/if}}"
              data-action="selectRace"
              data-race-id="{{this.id}}"
              data-race-name="{{this.name}}"
              data-pack-name="{{this.packName}}"
              role="option"
              aria-selected="{{#if (eq this.id ../characterData.race.id)}}true{{else}}false{{/if}}">
        <header class="axyum-info-card-head">
          <span class="axyum-info-card-glyph" aria-hidden="true">
            {{#if this.img}}
              <img class="axyum-info-card-portrait" src="{{this.img}}" alt="">
            {{else}}
              <i class="fas fa-dna"></i>
            {{/if}}
          </span>
          <span class="axyum-info-card-titles">
            <span class="axyum-info-card-title">{{this.name}}</span>
            {{#if this.source}}
              <span class="axyum-catalog-source {{#if this.isHomebrew}}is-homebrew{{else}}is-official{{/if}}">{{this.source}}</span>
            {{/if}}
          </span>
        </header>
        <div class="axyum-info-card-chips">
          <span class="axyum-meta-chip">{{this.sizeLabel}}</span>
          <span class="axyum-meta-chip axyum-meta-chip--accent">{{this.speedLabel}}</span>
          {{#if this.darkvision}}
            <span class="axyum-meta-chip">{{this.darkvision}}</span>
          {{/if}}
        </div>
        {{#if this.description}}
          <p class="axyum-info-card-blurb">{{this.description}}</p>
        {{else}}
          <p class="axyum-info-card-blurb muted">{{this.traitsLabel}}</p>
        {{/if}}
      </button>
    {{else}}
      <div class="empty-state">
        {{#if isLoading}}
          <p>{{localize "LD_AXYUM.Messages.LoadingCompendia"}}</p>
        {{else}}
          <p>{{localize "LD_AXYUM.Messages.NoCompendiumContent"}}</p>
          <p class="muted">Open the GM Hub and enable Item packs that contain races/species (dnd5e SRD or PHB).</p>
        {{/if}}
      </div>
    {{/each}}
  </div>

  {{#if characterData.race.id}}
    <div class="axyum-selection-bar">
      <div class="axyum-selection-bar-copy">
        <span class="page-kicker">Selected</span>
        <strong class="axyum-selection-bar-name">{{characterData.race.name}}</strong>
        {{#if characterData.race.source}}
          <span class="axyum-catalog-source is-official">{{characterData.race.source}}</span>
        {{/if}}
      </div>
    </div>
  {{/if}}

  <input type="hidden" name="race.id" value="{{characterData.race.id}}">
  <input type="hidden" name="race.name" value="{{characterData.race.name}}">
</div>
