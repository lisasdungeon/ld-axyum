<div class="axyum-page axyum-catalog-page equipment-page">
  <header class="page-intro">
    <p class="page-kicker">Starting equipment</p>
    <h2 class="axyum-page-title">Choose your class package</h2>
    <p class="axyum-page-description">
      {{#if character.class.name}}
        Pick the starting gear package for <strong>{{character.class.name}}</strong>. Items show name, quantity, and type.
      {{else}}
        Select a class first to load starting equipment packages.
      {{/if}}
    </p>
  </header>

  {{#if startingEquipment.packages.length}}
    <div class="axyum-catalog-toolbar">
      <div class="tally-chip">
        <span class="tally-label">Packages</span>
        <span class="tally-value">{{startingEquipment.packages.length}}</span>
      </div>
      {{#if characterData.startingPackageId}}
        <span class="axyum-meta-chip axyum-meta-chip--accent">Package selected</span>
      {{else}}
        <span class="muted">Select one package below</span>
      {{/if}}
    </div>

    <div class="axyum-package-grid">
      {{#each startingEquipment.packages}}
        <div class="axyum-package-card {{#if (eq this.id ../characterData.startingPackageId)}}is-selected{{/if}}">
          <button type="button"
                  class="axyum-package-select"
                  data-action="selectStartingPackage"
                  data-package-id="{{this.id}}">
            <span class="axyum-package-label">{{this.label}}</span>
            {{#if (eq this.id ../characterData.startingPackageId)}}
              <span class="axyum-meta-chip axyum-meta-chip--rec">Selected</span>
            {{/if}}
          </button>
          <ul class="axyum-package-items">
            {{#each this.items}}
              <li>
                <strong>{{this.name}}</strong>
                {{#if (gt this.count 1)}} ×{{this.count}}{{/if}}
                <span class="muted"> — {{this.type}}{{#if this.price}} · {{this.price}} gp{{/if}}</span>
                {{#if this.description}}
                  <div class="axyum-item-blurb">{{this.description}}</div>
                {{/if}}
              </li>
            {{/each}}
          </ul>
          {{#if this.choices.length}}
            {{#if (eq this.id ../characterData.startingPackageId)}}
              <div class="axyum-package-choices">
                {{#each this.choices}}
                  <div class="axyum-choice-block">
                    <span class="page-kicker">{{this.label}}</span>
                    <div class="axyum-chip-row">
                      {{#each this.options}}
                        <button type="button"
                                class="axyum-chip {{#if this.isChosen}}is-active{{/if}}"
                                data-action="selectPackageChoice"
                                data-package-id="{{this.packageId}}"
                                data-choice-id="{{this.choiceId}}"
                                data-option-id="{{this.id}}">
                          {{this.name}}{{#if (gt this.count 1)}} ×{{this.count}}{{/if}}
                        </button>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{/if}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    {{#if selectedPackageItems.length}}
      <div class="axyum-selection-bar">
        <div class="axyum-selection-bar-copy">
          <span class="page-kicker">In your pack</span>
          <strong class="axyum-selection-bar-name">{{selectedPackageItems.length}} items</strong>
        </div>
      </div>
      <div class="axyum-catalog-list">
        {{#each selectedPackageItems}}
          <div class="axyum-catalog-row axyum-catalog-row--simple is-selected">
            <span class="axyum-catalog-name">{{this.name}}{{#if (gt this.count 1)}} ×{{this.count}}{{/if}}</span>
            <span class="axyum-catalog-meta">
              <span class="axyum-meta-chip">{{this.type}}</span>
              {{#if this.price}}<span class="axyum-meta-chip">{{this.price}} gp</span>{{/if}}
            </span>
            <span class="axyum-catalog-source is-official">{{#if this.description}}{{this.description}}{{else}}Starting gear{{/if}}</span>
          </div>
        {{/each}}
      </div>
    {{/if}}
  {{else}}
    <div class="empty-state">
      {{#if character.class.name}}
        <p>No starting equipment package found for {{character.class.name}}.</p>
        <p class="muted">Enable the Player’s Handbook (or SRD) class packs in Configure Compendia, then re-select the class.</p>
      {{else}}
        <p>Select a class on the Class page first.</p>
      {{/if}}
    </div>
  {{/if}}
</div>
