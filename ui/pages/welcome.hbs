<div class="axyum-page welcome-page">
  <header class="welcome-hero">
    <p class="welcome-kicker">LD Axyum · Brass &amp; Ink · v0.2.4</p>
    <h2 class="axyum-page-title">Build a character that is ready to play</h2>
    <p class="axyum-page-description">
      Guided creation for D&amp;D 5e — class, species, background, abilities, skills, and gear —
      with live rules calculations as you go.
    </p>
  </header>

  <div class="welcome-grid">
    <section class="welcome-card">
      <h3>How it works</h3>
      <ol class="welcome-steps">
        <li>Pick a role and class</li>
        <li>Choose species and background</li>
        <li>Assign abilities, skills, and languages</li>
        <li>Review the summary and create the actor</li>
      </ol>
    </section>

    <section class="welcome-card welcome-card-accent">
      <h3>Content sources</h3>
      <p>
        Axyum loads from your world’s Item packs (dnd5e SRD and any enabled books).
        Optionally narrow sources with the compendium picker.
      </p>
      <button type="button" class="axyum-btn axyum-btn-primary" data-action="configureCompendia">
        <i class="fas fa-books"></i>
        <span>Configure Compendia</span>
      </button>
    </section>
  </div>

  <p class="welcome-ready">
    Ready? Click <strong>Next</strong> to start.
  </p>
</div>
