<div class="axyum-page axyum-catalog-page">
  <header class="page-intro">
    <p class="page-kicker">Class</p>
    <h2 class="axyum-page-title">Choose your vocation</h2>
    <p class="axyum-page-description">
      Class sets your hit die, armor and weapon training, and the features that define how you play.
      Role picks only highlight recommendations — every enabled book stays visible.
    </p>
  </header>

  <div class="axyum-catalog-toolbar">
    {{#if compendiumFilters}}
    <div class="axyum-catalog-filters" role="group" aria-label="Filter by source">
      <span class="axyum-toolbar-label"><i class="fas fa-filter" aria-hidden="true"></i> Source</span>
      <div class="axyum-chip-row">
        {{#each compendiumFilters}}
          <button type="button"
                  class="axyum-chip {{#if (eq this.id ../selectedCompendiumFilter)}}is-active{{/if}}"
                  data-action="filterCompendium"
                  data-filter="{{this.id}}">
            <span>{{this.name}}</span>
            <span class="axyum-chip-count">{{this.count}}</span>
          </button>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <label class="axyum-check-row axyum-check-row--compact">
      <input type="checkbox" name="showHomebrew" data-action="toggleHomebrew" {{#if showHomebrew}}checked{{/if}} />
      <span class="axyum-check"></span>
      <span class="axyum-check-text">
        <strong>Custom content</strong>
        <small>Include homebrew classes</small>
      </span>
    </label>
  </div>

  <div class="axyum-info-card-grid" role="listbox" aria-label="Classes">
    {{#each classes}}
      <button type="button"
              class="axyum-info-card {{#if (eq this.id ../characterData.class.id)}}is-selected{{/if}}"
              data-action="selectClass"
              data-class-id="{{this.id}}"
              data-class-name="{{this.name}}"
              data-pack-name="{{this.packName}}"
              role="option"
              aria-selected="{{#if (eq this.id ../characterData.class.id)}}true{{else}}false{{/if}}">
        <header class="axyum-info-card-head">
          <span class="axyum-info-card-glyph" aria-hidden="true">
            {{#if this.portrait}}
              <img class="axyum-info-card-portrait" src="{{this.portrait}}" alt="">
            {{else}}
              <i class="{{this.icon}}"></i>
            {{/if}}
          </span>
          <span class="axyum-info-card-titles">
            <span class="axyum-info-card-title">{{this.name}}</span>
            {{#if this.source}}
              <span class="axyum-catalog-source {{#if this.isHomebrew}}is-homebrew{{else}}is-official{{/if}}">{{this.source}}</span>
            {{/if}}
          </span>
          {{#if this.recommended}}
            <span class="axyum-meta-chip axyum-meta-chip--rec">Fits role</span>
          {{/if}}
        </header>
        <div class="axyum-info-card-chips">
          <span class="axyum-meta-chip">{{this.hitDieLabel}}</span>
          <span class="axyum-meta-chip {{#if this.spellcasting}}axyum-meta-chip--accent{{/if}}">{{this.spellcastingLabel}}</span>
          {{#if this.primaryAbility}}
            <span class="axyum-meta-chip">{{this.primaryAbility}}</span>
          {{/if}}
        </div>
        <dl class="axyum-info-card-facts">
          <div><dt>Saves</dt><dd>{{this.savesLabel}}</dd></div>
        </dl>
        {{#if this.description}}
          <p class="axyum-info-card-blurb">{{this.description}}</p>
        {{else}}
          <p class="axyum-info-card-blurb muted">Hit die {{this.hitDieLabel}} · {{this.spellcastingLabel}}</p>
        {{/if}}
      </button>
    {{else}}
      <div class="empty-state">
        {{#if isLoading}}
          <p>{{localize "LD_AXYUM.Messages.LoadingCompendia"}}</p>
        {{else}}
          <p>{{localize "LD_AXYUM.Messages.NoCompendiumContent"}}</p>
        {{/if}}
      </div>
    {{/each}}
  </div>

  {{#if characterData.class.id}}
    <div class="axyum-selection-bar">
      <div class="axyum-selection-bar-copy">
        <span class="page-kicker">Selected</span>
        <strong class="axyum-selection-bar-name">{{characterData.class.name}}</strong>
        {{#if characterData.class.source}}
          <span class="axyum-catalog-source {{#if characterData.class.isHomebrew}}is-homebrew{{else}}is-official{{/if}}">{{characterData.class.source}}</span>
        {{/if}}
      </div>
      <label class="axyum-level-field">
        <span>Level</span>
        <input type="number" id="primary-class-level" name="class.level" value="{{characterData.class.level}}" min="1" max="20">
      </label>
    </div>
  {{/if}}

  <input type="hidden" name="class.id" value="{{characterData.class.id}}">
  <input type="hidden" name="class.name" value="{{characterData.class.name}}">
  <input type="hidden" name="class.level" value="{{characterData.class.level}}">
</div>
