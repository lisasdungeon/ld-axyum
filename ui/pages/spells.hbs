<div class="axyum-page spells-page">
  <header class="page-intro">
    <h2 class="axyum-page-title">{{localize "LD_AXYUM.Pages.Spells"}}</h2>
    <p class="axyum-page-description">
      {{#if derivedStats.isSpellcaster}}
        {{localize "LD_AXYUM.Messages.SpellSelectionDescription"}}
      {{else}}
        {{localize "LD_AXYUM.Spells.NonCaster"}}
      {{/if}}
    </p>
  </header>

  {{#if derivedStats.isSpellcaster}}
    <div class="spell-summary-bar">
      <div class="spell-summary-main">
        <strong>{{characterData.class.name}}</strong>
        <span class="muted">Level {{characterData.class.level}}</span>
      </div>
      <div class="spell-tallies">
        <div class="tally-chip">
          <span class="tally-label">Cantrips</span>
          <span class="tally-value">{{derivedStats.selectedCantripCount}} / {{derivedStats.cantripCount}}</span>
        </div>
        <div class="tally-chip">
          <span class="tally-label">Max spell level</span>
          <span class="tally-value">{{derivedStats.maxSpellLevel}}</span>
        </div>
        <div class="tally-chip">
          <span class="tally-label">Spells</span>
          <span class="tally-value">{{derivedStats.selectedSpellCount}} / {{derivedStats.spellKnownCount}}</span>
        </div>
      </div>
    </div>

    {{#if derivedStats.spellSlots}}
      <section class="spell-slots-panel">
        <h3>{{localize "LD_AXYUM.Spells.SpellSlots"}}</h3>
        <div class="spell-slots-grid">
          {{#each derivedStats.spellSlots}}
            {{#if this}}
              <div class="spell-slot-cell">
                <span class="slot-level">L{{add @index 1}}</span>
                <span class="slot-count">{{this}}</span>
              </div>
            {{/if}}
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if (lookup spellsByLevel 0)}}
      <section class="spell-section">
        <div class="section-heading">
          <h3>{{localize "LD_AXYUM.Spells.Cantrips"}}</h3>
          <span class="section-tally">{{derivedStats.selectedCantripCount}} / {{derivedStats.cantripCount}}</span>
        </div>
        <p class="section-hint">{{localize "LD_AXYUM.Spells.SelectCantrips"}}</p>
        <div class="axyum-spells-grid">
          {{#each (lookup spellsByLevel 0)}}
            <label class="axyum-spell-card {{#if (includes ../characterData.selectedCantrips this.id)}}is-selected{{/if}}">
              <input type="checkbox"
                     name="cantrips"
                     value="{{this.id}}"
                     {{#if (includes ../characterData.selectedCantrips this.id)}}checked{{/if}}>
              <span class="spell-check" aria-hidden="true"></span>
              <span class="spell-card-content">
                <span class="spell-name">{{this.name}}</span>
                <span class="spell-school">{{this.school}}</span>
              </span>
            </label>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#each spellsByLevel}}
      {{#if @index}}
        <section class="spell-section">
          <div class="section-heading">
            <h3>{{localize "LD_AXYUM.Spells.Level" level=@index}}</h3>
          </div>
          <p class="section-hint">
            {{#if (lookup ../characterData.class "preparedSpells")}}
              {{localize "LD_AXYUM.Spells.SelectPrepared"}}
            {{else}}
              {{localize "LD_AXYUM.Spells.SelectKnown"}}
            {{/if}}
          </p>
          {{#if this.length}}
            <div class="axyum-spells-grid">
              {{#each this}}
                <label class="axyum-spell-card {{#if (includes ../../../characterData.selectedSpells this.id)}}is-selected{{/if}}">
                  <input type="checkbox"
                         name="spells"
                         value="{{this.id}}"
                         data-level="{{@../index}}"
                         {{#if (includes ../../../characterData.selectedSpells this.id)}}checked{{/if}}>
                  <span class="spell-check" aria-hidden="true"></span>
                  <span class="spell-card-content">
                    <span class="spell-name">{{this.name}}</span>
                    <span class="spell-school">{{this.school}}</span>
                  </span>
                </label>
              {{/each}}
            </div>
          {{else}}
            <p class="empty-note">{{localize "LD_AXYUM.Spells.NoSpells"}}</p>
          {{/if}}
        </section>
      {{/if}}
    {{/each}}
  {{else}}
    <div class="non-caster-panel">
      <p><strong>{{characterData.class.name}}</strong> does not prepare or know spells at character creation.</p>
      <p class="muted">Subclass features that grant spells (for example Eldritch Knight) can be added after creation.</p>
    </div>
  {{/if}}
</div>
