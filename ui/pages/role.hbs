<div class="axyum-page axyum-role-page">
  <header class="page-intro">
    <p class="page-kicker">Party dynamics</p>
    <h2 class="axyum-page-title">How do you fight beside the party?</h2>
    <p class="axyum-page-description">
      Pick a contribution style — not a class. Any class can lean into several roles;
      this only shapes which classes we recommend next.
    </p>
  </header>

  <div class="axyum-role-studio">
    <div class="axyum-role-rail" role="listbox" aria-label="Party roles">
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 0)}}is-selected{{/if}}" data-action="selectRole" data-role-index="0" role="option" aria-selected="{{#if (eq selectedRoleIndex 0)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Tank'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Tank</span>
          <span class="axyum-pick-sub">Defender · draws fire</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 1)}}is-selected{{/if}}" data-action="selectRole" data-role-index="1" role="option" aria-selected="{{#if (eq selectedRoleIndex 1)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Striker'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Striker</span>
          <span class="axyum-pick-sub">Damage · ends threats</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 2)}}is-selected{{/if}}" data-action="selectRole" data-role-index="2" role="option" aria-selected="{{#if (eq selectedRoleIndex 2)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Controller'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Controller</span>
          <span class="axyum-pick-sub">Tempo · shapes the field</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 3)}}is-selected{{/if}}" data-action="selectRole" data-role-index="3" role="option" aria-selected="{{#if (eq selectedRoleIndex 3)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Support'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Support</span>
          <span class="axyum-pick-sub">Buffer · lifts the party</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 4)}}is-selected{{/if}}" data-action="selectRole" data-role-index="4" role="option" aria-selected="{{#if (eq selectedRoleIndex 4)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Healer'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Healer</span>
          <span class="axyum-pick-sub">Triage · keeps people up</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 5)}}is-selected{{/if}}" data-action="selectRole" data-role-index="5" role="option" aria-selected="{{#if (eq selectedRoleIndex 5)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Skill Monkey'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Skill Monkey</span>
          <span class="axyum-pick-sub">Utility · solves the map</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 6)}}is-selected{{/if}}" data-action="selectRole" data-role-index="6" role="option" aria-selected="{{#if (eq selectedRoleIndex 6)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Face'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Face</span>
          <span class="axyum-pick-sub">Social · owns the room</span>
        </span>
      </button>
      <button type="button" class="axyum-pick-option {{#if (eq selectedRoleIndex 7)}}is-selected{{/if}}" data-action="selectRole" data-role-index="7" role="option" aria-selected="{{#if (eq selectedRoleIndex 7)}}true{{else}}false{{/if}}">
        <span class="axyum-pick-glyph" aria-hidden="true"><img class="axyum-pick-portrait" src="{{lookup roleImages 'Flexible'}}" alt=""></span>
        <span class="axyum-pick-copy">
          <span class="axyum-pick-title">Flexible</span>
          <span class="axyum-pick-sub">No filter · show everything</span>
        </span>
      </button>
    </div>

    <aside class="axyum-role-stage">
      {{#if (ne selectedRoleIndex null)}}
        <div class="axyum-role-detail">
          <p class="page-kicker">Selected role</p>
          <h3 class="axyum-role-detail-title">
            {{#if (eq selectedRoleIndex 0)}}Tank — Defender
            {{else if (eq selectedRoleIndex 1)}}Striker — Damage
            {{else if (eq selectedRoleIndex 2)}}Controller
            {{else if (eq selectedRoleIndex 3)}}Support — Buffer
            {{else if (eq selectedRoleIndex 4)}}Healer
            {{else if (eq selectedRoleIndex 5)}}Skill Monkey
            {{else if (eq selectedRoleIndex 6)}}Face — Social
            {{else}}Flexible — All classes{{/if}}
          </h3>

          {{#if (eq selectedRoleIndex 0)}}
            <p class="axyum-role-lede">Frontline protector. Draw attention, soak hits, and keep weaker allies off the menu.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>High AC / HP, defensive locks, choke-point control</dd></div>
              <div><dt>Tactics</dt><dd>Compelled Duel, Sentinel, Reckless Attack — force focus fire onto you</dd></div>
              <div><dt>Fits</dt><dd>Fighter, Paladin, Barbarian (Bear / Zealot)</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 1)}}
            <p class="axyum-role-lede">High-output specialist. Delete priority targets before they act twice.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>Strong DPR, advantage stacking, burst or precision focus</dd></div>
              <div><dt>Tactics</dt><dd>Hunt casters and leaders; combo off ally control</dd></div>
              <div><dt>Fits</dt><dd>Rogue, Ranger, Fighter, Sorcerer</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 2)}}
            <p class="axyum-role-lede">Shapes space and tempo. Lock movement, blind sightlines, dictate the map.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>Zones, walls, conditions, battlefield awareness</dd></div>
              <div><dt>Tactics</dt><dd>Funnel foes into tank zones; cut escape routes</dd></div>
              <div><dt>Fits</dt><dd>Wizard, Druid, Cleric (Tempest / Light)</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 3)}}
            <p class="axyum-role-lede">Makes everyone else better — buffs, advantage, and resource timing.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>Bless / Haste / Inspiration, concentration management</dd></div>
              <div><dt>Tactics</dt><dd>Empower allies before they swing; sustain key effects</dd></div>
              <div><dt>Fits</dt><dd>Bard, Cleric, Paladin</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 4)}}
            <p class="axyum-role-lede">Triage specialist. Restore HP, clear conditions, prevent downs.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>Healing Word, restorations, revive tools, resource timing</dd></div>
              <div><dt>Tactics</dt><dd>Reactive saves over overheal; prevent the first drop</dd></div>
              <div><dt>Fits</dt><dd>Cleric, Druid (Dreams), Paladin</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 5)}}
            <p class="axyum-role-lede">Utility expert for exploration, traps, scouting, and odd jobs.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>Skill depth, Expertise, tools, investigation</dd></div>
              <div><dt>Tactics</dt><dd>Win before combat — intel, shortcuts, trap clears</dd></div>
              <div><dt>Fits</dt><dd>Rogue, Bard (Lore), Ranger</dd></div>
            </dl>
          {{else if (eq selectedRoleIndex 6)}}
            <p class="axyum-role-lede">Spokesperson. Persuasion, deception, intimidation — talk past the fight.</p>
            <dl class="axyum-role-facts">
              <div><dt>Traits</dt><dd>High Charisma, social skills, strong RP drive</dd></div>
              <div><dt>Tactics</dt><dd>Deals, intel, allies — reshape the session with words</dd></div>
              <div><dt>Fits</dt><dd>Bard, Paladin, Warlock, Sorcerer</dd></div>
            </dl>
          {{else}}
            <p class="axyum-role-lede">No role filter. Browse every class on the next page.</p>
            <dl class="axyum-role-facts">
              <div><dt>Note</dt><dd>Many builds cover two or three roles — Bard (Support + Face + Skills), Paladin (Tank + Support + Heal).</dd></div>
            </dl>
          {{/if}}
        </div>
      {{else}}
        <div class="axyum-role-empty">
          <i class="fas fa-compass" aria-hidden="true"></i>
          <p>Select a role on the left to see how it plays at the table.</p>
        </div>
      {{/if}}
    </aside>
  </div>

  <p class="axyum-footnote">
    A balanced party usually covers at least four of these. Next page lists every class from your books;
    role matches are tagged “Fits role” and sorted to the top.
  </p>
</div>
