<div class="pf2e-page pf2e-welcome">
  <h2>Create a Pathfinder 2e Character</h2>
  <p>Walk through ancestry, heritage, background, class, ability boosts, skills, feats, spells, and equipment to build a complete character.</p>

  <div class="form-group">
    <label for="pf2e-name">Character Name</label>
    <input id="pf2e-name" type="text" name="name" value="{{characterData.name}}" placeholder="Character name" />
  </div>

  <div class="form-group">
    <label for="pf2e-level">Starting Level</label>
    <input id="pf2e-level" type="number" name="level" min="1" max="20" value="{{characterData.level}}" />
  </div>

  <div class="form-group">
    <label>
      <input type="checkbox" data-action="toggleProficiencyWithoutLevel" {{#if characterData.proficiencyWithoutLevel}}checked{{/if}} />
      Use the "Proficiency without Level" variant
    </label>
  </div>
</div>
