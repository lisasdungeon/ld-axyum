<div class="pf2e-page">
  <h2>Details</h2>

  <div class="form-group">
    <label for="pf2e-deity">Deity</label>
    <input id="pf2e-deity" type="text" name="details.deity" value="{{characterData.details.deity}}" />
  </div>

  <div class="form-group">
    <label for="pf2e-edicts">Edicts</label>
    <textarea id="pf2e-edicts" name="details.edicts">{{characterData.details.edicts}}</textarea>
  </div>

  <div class="form-group">
    <label for="pf2e-anathema">Anathema</label>
    <textarea id="pf2e-anathema" name="details.anathema">{{characterData.details.anathema}}</textarea>
  </div>

  <div class="pf2e-grid-3">
    <div class="form-group">
      <label for="pf2e-age">Age</label>
      <input id="pf2e-age" type="text" name="details.age" value="{{characterData.details.age}}" />
    </div>
    <div class="form-group">
      <label for="pf2e-height">Height</label>
      <input id="pf2e-height" type="text" name="details.height" value="{{characterData.details.height}}" />
    </div>
    <div class="form-group">
      <label for="pf2e-weight">Weight</label>
      <input id="pf2e-weight" type="text" name="details.weight" value="{{characterData.details.weight}}" />
    </div>
  </div>

  <div class="form-group">
    <label for="pf2e-appearance">Appearance</label>
    <textarea id="pf2e-appearance" name="details.appearance">{{characterData.details.appearance}}</textarea>
  </div>

  <div class="form-group">
    <label for="pf2e-backstory">Backstory</label>
    <textarea id="pf2e-backstory" name="details.backstory" rows="6">{{characterData.details.backstory}}</textarea>
  </div>
</div>
