<!-- LD Axyum PF2e Wizard Shell -->
<form class="axyum-form ld-axyum-layout" onsubmit="event.preventDefault();">

  <header class="axyum-topbar">
    <div class="axyum-branding">
      <div class="brand-text">AXYUM</div>
    </div>

    <nav class="axyum-steps">
      <ul class="steps-list">
        {{#each steps as |step index|}}
        <li class="step-item {{#if (eq ../currentPage step.id)}}active{{/if}} {{#if (gt ../currentPageIndex index)}}completed{{/if}}"
            title="{{step.label}}">
          <div class="step-marker">
            {{#if (gt ../currentPageIndex index)}}
              <i class="fas fa-check"></i>
            {{else}}
              <span>{{add index 1}}</span>
            {{/if}}
          </div>
          <span class="step-label">{{step.label}}</span>
        </li>
        {{/each}}
      </ul>
    </nav>

    <div class="version-info">PF2e</div>
  </header>

  <div class="axyum-body-container">

    <div class="axyum-main-panel">

      <div class="step-header">
        <h2 class="step-title">{{currentStepLabel}}</h2>
        <div class="step-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: {{percent currentPageIndex totalPages}}%"></div>
          </div>
        </div>
      </div>

      <main class="axyum-content">
        <div class="content-wrapper">
          {{#if (eq currentPage "welcome")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/welcome this}}
          {{else if (eq currentPage "ancestry")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/ancestry this}}
          {{else if (eq currentPage "heritage")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/heritage this}}
          {{else if (eq currentPage "background")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/background this}}
          {{else if (eq currentPage "class")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/class this}}
          {{else if (eq currentPage "key-ability")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/key-ability this}}
          {{else if (eq currentPage "ability-boosts")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/ability-boosts this}}
          {{else if (eq currentPage "skills")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/skills this}}
          {{else if (eq currentPage "feats")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/feats this}}
          {{else if (eq currentPage "spells")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/spells this}}
          {{else if (eq currentPage "equipment")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/equipment this}}
          {{else if (eq currentPage "details")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/details this}}
          {{else if (eq currentPage "summary")}}
            {{> modules/ld-axyum/systems/pf2e/wizard/pages/summary this}}
          {{/if}}
        </div>
      </main>

      <footer class="axyum-footer">
        <div class="axyum-nav-buttons">
          {{#unless isFirstPage}}
            <button type="button" class="axyum-prev axyum-btn axyum-btn-secondary" data-action="previous">
              <i class="fas fa-chevron-left"></i>
              <span>Back</span>
            </button>
          {{else}}
            <div></div>
          {{/unless}}

          {{#unless isLastPage}}
            <button type="button" class="axyum-next axyum-btn axyum-btn-primary" data-action="next">
              <span>Next</span>
              <i class="fas fa-chevron-right"></i>
            </button>
          {{else}}
            {{#if (eq mode "create")}}
              <button type="button" class="axyum-create axyum-btn axyum-btn-success" data-action="create">
                <i class="fas fa-check-circle"></i>
                <span>Create Character</span>
              </button>
            {{else}}
              <button type="button" class="axyum-save axyum-btn axyum-btn-success" data-action="save">
                <i class="fas fa-save"></i>
                <span>Save Changes</span>
              </button>
            {{/if}}
          {{/unless}}
        </div>
      </footer>
    </div>

    <aside class="axyum-preview-sidebar">
      <div class="preview-header">
        <h3><i class="fas fa-scroll"></i> Live Character Preview</h3>
      </div>
      <div class="preview-content">
        {{> modules/ld-axyum/systems/pf2e/wizard/templates/pf2e-preview}}
      </div>
    </aside>

  </div>
</form>
